{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memoar",
  "version": "0.3.0",
  "identifier": "dev.memoar.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Memoar",
        "width": 560,
        "height": 660,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
