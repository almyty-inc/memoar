{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoar.dev/contracts/canonical/0.1.1/session.schema.json",
  "title": "Memoar canonical session",
  "$ref": "#/$defs/Session",
  "$defs": {
    "SourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "tool",
        "version",
        "machineId"
      ],
      "properties": {
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "machineId": {
          "$ref": "#/$defs/Uuid"
        },
        "nativeSessionId": {
          "type": "string"
        }
      }
    },
    "WorkspaceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "gitRemote": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      }
    },
    "TokenTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "cacheRead": {
          "type": "integer",
          "minimum": 0
        },
        "cacheWrite": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ProvenanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "capturedAt"
      ],
      "properties": {
        "kind": {
          "enum": [
            "native",
            "import",
            "conversion",
            "distillation"
          ]
        },
        "sourceId": {
          "type": "string"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parserVersion": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ownerId"
      ],
      "properties": {
        "scope": {
          "enum": [
            "private",
            "team",
            "org",
            "link"
          ]
        },
        "ownerId": {
          "$ref": "#/$defs/Uuid"
        },
        "teamId": {
          "$ref": "#/$defs/Uuid"
        },
        "orgId": {
          "$ref": "#/$defs/Uuid"
        }
      }
    },
    "ContentBlockKind": {
      "enum": [
        "text",
        "thinking",
        "tool_call",
        "tool_result",
        "diff",
        "artifact",
        "attachment",
        "system",
        "error"
      ]
    },
    "ContentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "kind": {
          "$ref": "#/$defs/ContentBlockKind"
        },
        "text": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "callId": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "artifactRef": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        },
        "ext": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "parentId",
        "role",
        "createdAt",
        "blocks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "parentId": {
          "oneOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "model": {
          "type": "string"
        },
        "tokens": {
          "$ref": "#/$defs/TokenTotals"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentBlock"
          }
        },
        "ext": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "AnnotationKind": {
      "enum": [
        "tag",
        "collection",
        "pin",
        "note",
        "summary",
        "redaction_mask"
      ]
    },
    "Annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sessionId",
        "kind",
        "value",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "$ref": "#/$defs/Uuid"
        },
        "turnId": {
          "$ref": "#/$defs/Uuid"
        },
        "blockId": {
          "$ref": "#/$defs/Uuid"
        },
        "kind": {
          "$ref": "#/$defs/AnnotationKind"
        },
        "value": {
          "type": "object",
          "additionalProperties": true
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "RawArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "size",
        "objectKey",
        "status",
        "capturedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "default": []
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "objectKey": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "stored",
            "queued",
            "parsed",
            "unknown_format",
            "failed"
          ]
        },
        "sourcePath": {
          "type": "string"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "diagnostic": {
          "type": "string"
        }
      }
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "workspace",
        "createdAt",
        "updatedAt",
        "title",
        "models",
        "tokenTotals",
        "provenance",
        "visibility",
        "turns"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "source": {
          "$ref": "#/$defs/SourceDescriptor"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceDescriptor"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tokenTotals": {
          "$ref": "#/$defs/TokenTotals"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ProvenanceEntry"
          }
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Turn"
          }
        },
        "ext": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "MemoryScope": {
      "enum": [
        "global",
        "project"
      ]
    },
    "MemoryDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "machineId",
        "path",
        "title",
        "readers",
        "contentHash",
        "capturedAt",
        "visibility"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "scope": {
          "$ref": "#/$defs/MemoryScope"
        },
        "machineId": {
          "$ref": "#/$defs/Uuid"
        },
        "workspacePath": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "readers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProvenanceEntry"
          },
          "default": []
        }
      }
    },
    "MemoryRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "documentId",
        "contentHash",
        "text",
        "size",
        "capturedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "documentId": {
          "$ref": "#/$defs/Uuid"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "text": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
