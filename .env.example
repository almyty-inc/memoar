NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Runtime connection. MUST NOT be a superuser or hold BYPASSRLS: those roles
# ignore row-level security, which would disable every tenant policy.
DATABASE_URL=postgres://memoar_app:memoar_app@localhost:55432/memoar
# Owner connection used only to run migrations (DDL). Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=postgres://memoar:memoar@localhost:55432/memoar
# Password assigned to the memoar_app role by the AppRole migration.
MEMOAR_APP_DB_PASSWORD=memoar_app
REDIS_URL=redis://localhost:56379
S3_ENDPOINT=http://localhost:59000
S3_REGION=eu-central-1
S3_BUCKET=memoar-raw
S3_ACCESS_KEY=memoar-local
S3_SECRET_KEY=memoar-local-secret
MEMOAR_TOKEN_SECRET=local-development-only-change-me
VITE_API_URL=http://localhost:4000/v1
