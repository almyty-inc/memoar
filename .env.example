NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Runtime connection. MUST NOT be a superuser or hold BYPASSRLS: those roles
# ignore row-level security, which would disable every tenant policy.
DATABASE_URL=postgres://memoar_app:memoar_app@localhost:55432/memoar
# Owner connection used only to run migrations (DDL). Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=postgres://memoar:memoar@localhost:55432/memoar
# Password assigned to the memoar_app role by the AppRole migration.
MEMOAR_APP_DB_PASSWORD=memoar_app
REDIS_URL=redis://localhost:56379
# Object storage. These values are the MinIO container in
# deploy/docker-compose.dev.yml, which is what a local stack talks to.
S3_ENDPOINT=http://localhost:59000
S3_REGION=eu-central-1
S3_BUCKET=memoar-raw
S3_ACCESS_KEY=memoar-local
S3_SECRET_KEY=memoar-local-secret
# Where a pre-signed URL points, as opposed to where the server talks to
# storage. `GET /v1/convert/{id}/download` does not send the bytes: it redirects
# to a pre-signed URL and the caller fetches them itself, so the host in that URL
# has to be one the caller can resolve. Unset outside production it defaults to
# http://localhost:59000, which is right for the compose stack and wrong for
# anything else — a server inside a container or a cluster signing against its
# own private address gives every external caller a DNS failure it cannot
# explain. The signature covers the host, so this must match exactly.
S3_PUBLIC_ENDPOINT=http://localhost:59000
#
# A deployed instance points these at a real object store rather than at MinIO.
# For DigitalOcean Spaces, endpoint and public endpoint are the same host —
# a Space is already reachable from outside — and the region is the datacenter
# in that hostname:
#
#   S3_ENDPOINT=https://fra1.digitaloceanspaces.com
#   S3_PUBLIC_ENDPOINT=https://fra1.digitaloceanspaces.com
#   S3_REGION=fra1
#   S3_BUCKET=memoar-raw
#
# Bucket versioning and lifecycle rules are settings on the bucket, not on this
# server, and nothing here turns them on. docs/backup.md has the commands and,
# first, the command that tells you whether they were ever run.
# Every value in this file is published in this repository, so the API and
# worker refuse to start with any of them when NODE_ENV=production. Generate
# real ones, for example: openssl rand -hex 32
MEMOAR_TOKEN_SECRET=local-development-only-change-me
VITE_API_URL=http://localhost:4000/v1

# The largest artifact an upload may carry. This number appears in three places
# and they must agree: here, MAX_ARTIFACT_BYTES in the capture agent (which
# refuses a larger file before sending), and the body-size limit on whatever
# proxy or ingress fronts the API. Whichever is smallest is the real ceiling,
# and a client that checked against a different one gets a rejection it cannot
# explain. 256 MiB is the agent's value and the server's default.
MEMOAR_MAX_ARTIFACT_BYTES=268435456
# A manifest is metadata, not payload; 256 artifacts with real capture paths in
# them are still larger than body-parser's 100kb default.
MEMOAR_MAX_MANIFEST_BYTES=8mb

# The first account, created once if it does not already exist. There is no
# default for either value: without them the server creates nobody, and an
# account that already exists is never overwritten by what is set here.
MEMOAR_BOOTSTRAP_EMAIL=owner@memoar.local
MEMOAR_BOOTSTRAP_PASSWORD=local-stack-password-change-me

# Local conveniences that bypass authentication entirely: a fixed bearer token,
# and X-Memoar-Tenant / X-Memoar-User headers that name whatever tenant they
# like. Off unless this says otherwise, and the server refuses to start in
# production with it on.
MEMOAR_DEV_AUTH=false

# /v1/metrics exists only while this is set, and always requires it as a bearer
# token. Unset, the endpoint returns 404 rather than 403: an endpoint that
# answers differently when unconfigured advertises that it is there.
# The worker has no HTTP server of its own and listens on its own port.
MEMOAR_METRICS_TOKEN=local-stack-metrics-token
MEMOAR_WORKER_METRICS_PORT=9464

# How many proxies sit in front of the API. Express reads the client address
# from X-Forwarded-For only when this is set, and trusts exactly this many hops.
# Leave at 0 when the API is reached directly: trusting the header without a
# proxy in front lets any caller claim a new address per request, which buys a
# new rate-limit budget per request. Behind one load balancer, set 1.
MEMOAR_TRUSTED_PROXY_HOPS=0
# Requests per caller per window, as "limit/seconds". The credential budget
# counts failed sign-ins against one account, not attempts.
MEMOAR_RATE_LIMIT=300/60
MEMOAR_CREDENTIAL_RATE_LIMIT=10/300

# Encrypts the provider credentials accounts bring for distillation, which is
# the only feature that sends archived content to a third party. 32 bytes, as
# 64 hex characters or base64: openssl rand -hex 32
# Without it the API refuses to store a credential rather than storing it weakly.
MEMOAR_CREDENTIAL_KEY=

# Lets accounts with no credential of their own fall back to the operator's
# ANTHROPIC_API_KEY. Off by default, because on it means one key pays for every
# account and every account's sessions go through the operator's provider. The
# legitimate case is a single-user self-host.
MEMOAR_ALLOW_SHARED_DISTILLATION_KEY=false

# Where the grouped error counts are written, so they survive a restart. Unset,
# they live only in memory and go with the process. Give each process its own
# path: the API and the worker group their own failures.
MEMOAR_ERROR_STATE_PATH=
