{
  "description": "The secret rules both scanners must hold, in order. server/src/secret-catalogue.ts and agent/crates/memoar-daemon/src/secret_catalogue.rs are each tested against this file.",
  "rules": [
    {"id":"pem-private-key","kind":"private_key","caseInsensitive":false,"pattern":"-----BEGIN (?:[A-Z0-9]+ ){0,3}PRIVATE KEY(?: BLOCK)?-----(?:(?:\\r?\\n|\\\\r?\\\\n)[A-Za-z][A-Za-z-]{0,31}: [A-Za-z0-9 ,.:;/+=()_-]{0,100}){0,4}[A-Za-z0-9+/=\\\\ \\t\\r\\n]+-----END (?:[A-Z0-9]+ ){0,3}PRIVATE KEY(?: BLOCK)?-----"},
    {"id":"authorization-header","kind":"credential","caseInsensitive":true,"pattern":"(?:proxy-)?authorization[\"']?[ \\t]*[:=][ \\t]*[\"']?(?:(?:bearer|basic|token|digest)[ \\t]+)?(?<secret>[^ \\t\\r\\n\\x0B\\x0C\"',;{}\\[\\]\\\\]+)"},
    {"id":"aws-access-key-id","kind":"api_key","caseInsensitive":false,"pattern":"\\b(?:AKIA|ASIA|ABIA|ACCA|A3T[A-Z0-9])[A-Z0-9]{16}\\b"},
    {"id":"aws-secret-access-key","kind":"credential","caseInsensitive":true,"pattern":"(?:aws[A-Za-z0-9_.-]{0,20})?secret[_-]?access[_-]?key[\"']?[ \\t]*[:=][ \\t]*[\"']?(?<secret>[A-Za-z0-9/+=]{40,128})"},
    {"id":"gcp-api-key","kind":"api_key","caseInsensitive":false,"pattern":"\\bAIza[A-Za-z0-9_-]{35}"},
    {"id":"google-oauth-client-secret","kind":"api_key","caseInsensitive":false,"pattern":"\\bGOCSPX-[A-Za-z0-9_-]{28}"},
    {"id":"azure-storage-key","kind":"connection_string","caseInsensitive":true,"pattern":"(?:AccountKey|SharedAccessKey|SharedSecretValue)[ \\t]*=[ \\t]*(?<secret>[A-Za-z0-9+/]{20,256}={0,2})"},
    {"id":"azure-sas-signature","kind":"connection_string","caseInsensitive":false,"pattern":"[?&;]sig=(?<secret>[A-Za-z0-9%+/=]{16,256})"},
    {"id":"azure-ad-client-secret","kind":"api_key","caseInsensitive":false,"pattern":"\\b[A-Za-z0-9_~.]{3}[78]Q~[A-Za-z0-9_~.-]{31,34}"},
    {"id":"github-token","kind":"api_key","caseInsensitive":false,"pattern":"\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,255}\\b"},
    {"id":"github-fine-grained-pat","kind":"api_key","caseInsensitive":false,"pattern":"\\bgithub_pat_[A-Za-z0-9_]{22,255}\\b"},
    {"id":"gitlab-token","kind":"api_key","caseInsensitive":false,"pattern":"\\bgl(?:pat|dt|ptt|rt|soat|cbt|imt|ffct|agent|oas)-[A-Za-z0-9_.-]{20,255}"},
    {"id":"slack-token","kind":"api_key","caseInsensitive":false,"pattern":"\\bxox(?:e\\.xox[bp]|[abposre])-[A-Za-z0-9-]{10,255}"},
    {"id":"slack-app-token","kind":"api_key","caseInsensitive":false,"pattern":"\\bxapp-[0-9]{1,4}-[A-Za-z0-9-]{10,255}"},
    {"id":"slack-webhook","kind":"api_key","caseInsensitive":false,"pattern":"hooks\\.slack\\.com/(?:services|workflows|triggers)/(?<secret>[A-Za-z0-9/_-]{20,255})"},
    {"id":"stripe-key","kind":"api_key","caseInsensitive":false,"pattern":"\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,255}\\b"},
    {"id":"stripe-webhook-secret","kind":"api_key","caseInsensitive":false,"pattern":"\\bwhsec_[A-Za-z0-9]{24,255}\\b"},
    {"id":"npm-token","kind":"api_key","caseInsensitive":false,"pattern":"\\bnpm_[A-Za-z0-9]{36}\\b"},
    {"id":"pypi-token","kind":"api_key","caseInsensitive":false,"pattern":"\\bpypi-AgE[A-Za-z0-9_-]{50,}"},
    {"id":"anthropic-key","kind":"api_key","caseInsensitive":false,"pattern":"\\bsk-ant-[a-z]{2,8}[0-9]{2}-[A-Za-z0-9_-]{20,255}"},
    {"id":"openai-key","kind":"api_key","caseInsensitive":false,"pattern":"\\bsk-(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,255}"},
    {"id":"huggingface-token","kind":"api_key","caseInsensitive":false,"pattern":"\\bhf_[A-Za-z0-9]{30,255}\\b"},
    {"id":"twilio-api-key","kind":"api_key","caseInsensitive":false,"pattern":"\\bSK[0-9a-fA-F]{32}\\b"},
    {"id":"twilio-auth-token","kind":"credential","caseInsensitive":true,"pattern":"twilio[A-Za-z0-9_.-]{0,30}token[\"']?[ \\t]*[:=][ \\t]*[\"']?(?<secret>[a-f0-9]{32})"},
    {"id":"sendgrid-key","kind":"api_key","caseInsensitive":false,"pattern":"\\bSG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}"},
    {"id":"memoar-token","kind":"api_key","caseInsensitive":false,"pattern":"\\bmemoar_[A-Za-z0-9_-]{40,255}"},
    {"id":"generic-sk-key","kind":"api_key","caseInsensitive":false,"pattern":"\\bsk[_-][A-Za-z0-9_-]{16,255}"},
    {"id":"jwt","kind":"jwt","caseInsensitive":false,"pattern":"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}"},
    {"id":"url-credentials","kind":"connection_string","caseInsensitive":true,"pattern":"\\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|rediss?|amqps?|mssql|sqlserver|clickhouse|cockroachdb|https?|s?ftp|smtps?|ldaps?|ssh|git)://[^:/@ \\t\\r\\n\"'\\\\\\[\\]]{0,256}:(?<secret>[^@/ \\t\\r\\n\"'\\\\\\[\\]]{1,256})@"},
    {"id":"generic-assignment","kind":"credential","caseInsensitive":true,"pattern":"\\b[A-Za-z0-9_.-]{0,64}(?:api[_-]?key|access[_-]?key|(?:auth|access|refresh|bearer|session|api|bot|npm|github|gitlab|gh|slack|hf|pypi)[_-]?token|client[_-]?secret|private[_-]?key|password|passwd|secret)[A-Za-z0-9_.-]{0,40}[\"']?[ \\t]*[:=][ \\t]*[\"']?(?<secret>[^ \\t\\r\\n\\x0B\\x0C\"',;{}\\[\\]\\\\]+)"}
  ]
}
