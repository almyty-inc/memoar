{
  "name": "@memoar/server",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch main.ts",
    "start": "node dist/main.js",
    "worker": "tsx worker.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:fast": "MEMOAR_TEST_POSTGRES=0 vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "bullmq": "^6.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^5.0.0"
  }
}
